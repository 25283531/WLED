<?xml version="1.0" encoding="utf-8"?>
<!--
    API 26+ 自适应图标（光屿 / LumiIsle）：
    前景层 = 用户提供的原图位图（深空夜色底 + 两股青→蓝→紫旋转交织的丝绸光带
    + 底部三圈同心青色椭圆涟漪），背景层 = 与原图同色的深空对角渐变，
    单色层 = 从同一张原图提取的主体剪影（供 Android 13+ 主题图标上色）。
    与固件灯效 221「极光之舞」同源同色、互相呼应。
    位图由 tools/gen_app_icon.py 生成，源图 docs/assets/lumi_aurora_icon_source.jpg。
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@drawable/ic_launcher_background" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
    <monochrome android:drawable="@drawable/ic_launcher_monochrome" />
</adaptive-icon>
