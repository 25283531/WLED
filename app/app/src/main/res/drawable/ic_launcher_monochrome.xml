<?xml version="1.0" encoding="utf-8"?>
<!--
    单色图标（Android 13+ 主题图标 / themed icon）：只取剪影，由系统上色。
    剪影取自同一张原图 —— 用大半径模糊估计背景场，取「与背景的差」得到主体轮廓，
    因此轮廓与彩色版严格同源，不会出现两版图形对不齐。
    位图由 tools/gen_app_icon.py 生成到 mipmap-*/ic_launcher_monochrome.png。
-->
<bitmap xmlns:android="http://schemas.android.com/apk/res/android"
    android:src="@mipmap/ic_launcher_monochrome"
    android:gravity="fill" />
